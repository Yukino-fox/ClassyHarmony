{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 课前提醒走 reminderAgentManager 的周期提醒。没有这一条，
    // publishReminder 直接被系统拒绝（1600004 权限不足），而界面上看不出
    // 任何原因 —— 表现为「怎么改设置都不出提醒」。
    // requestEnableNotification 弹的那个系统弹窗是另一回事，它在运行时申请。
    "requestPermissions": [
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER"
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:location_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.DISTRIBUTED_DATASYNC",
        "reason": "$string:distributed_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // 系统权限（system_grant / normal），声明即生效，不需要 reason 与 usedScene。
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // 连续任务（长时任务）声明的使用场景，取值与 BackgroundMode 一一对应。
        // multiDeviceConnection：跨设备同步开启时用（手机上也允许）。
        // taskKeeping：自动化在后台继续跑（2in1 自 API 21 免 ACL，手机上普通应用申请不到）。
        "backgroundModes": [
          "multiDeviceConnection",
          "taskKeeping"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      },
      {
        "name": "EntryFormAbility",
        "srcEntry": "./ets/widget/EntryFormAbility.ets",
        "description": "$string:EntryFormAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryFormAbility_label",
        "type": "form",
        // exported 必须为 true：卡片是由系统的卡片选择器在另一个应用里拉起的，
        // 不导出的话卡片在选择器里根本不出现，且没有任何报错。
        "exported": true,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}